# Judge0 configuration for CodeArena (based on the official v1.13.1 judge0.conf).
# Copy to judge0.conf (git-ignored) and replace every CHANGE_ME value with a
# long random string, e.g.:  openssl rand -hex 32
# Never commit judge0.conf.

################################################################################
# Authentication: CodeArena sends AUTHN_TOKEN in the X-Auth-Token header.
# Put the same value in backend/.env as JUDGE0_API_KEY.
################################################################################
AUTHN_HEADER=X-Auth-Token
AUTHN_TOKEN=CHANGE_ME
AUTHZ_HEADER=X-Auth-User
AUTHZ_TOKEN=CHANGE_ME

################################################################################
# Hardening: CodeArena only needs plain submissions + polling.
################################################################################
# Student programs never get network access.
ENABLE_NETWORK=false
ALLOW_ENABLE_NETWORK=false
# No callbacks (prevents Judge0 from calling arbitrary URLs).
ENABLE_CALLBACKS=false
# Features CodeArena does not use stay off.
ENABLE_COMPILER_OPTIONS=false
ENABLE_COMMAND_LINE_ARGUMENTS=false
ENABLE_ADDITIONAL_FILES=false
ENABLE_SUBMISSION_DELETE=false
ENABLE_WAIT_RESULT=false
ENABLE_BATCHED_SUBMISSIONS=true
MAX_SUBMISSION_BATCH_SIZE=20
MAX_QUEUE_SIZE=100

################################################################################
# Limits. CodeArena sends per-problem limits; these are defaults and ceilings.
################################################################################
CPU_TIME_LIMIT=2
MAX_CPU_TIME_LIMIT=15
CPU_EXTRA_TIME=0.5
MAX_CPU_EXTRA_TIME=2
WALL_TIME_LIMIT=5
MAX_WALL_TIME_LIMIT=20
MEMORY_LIMIT=256000
MAX_MEMORY_LIMIT=512000
STACK_LIMIT=64000
MAX_STACK_LIMIT=128000
MAX_PROCESSES_AND_OR_THREADS=60
MAX_MAX_PROCESSES_AND_OR_THREADS=120
ENABLE_PER_PROCESS_AND_THREAD_TIME_LIMIT=false
ALLOW_ENABLE_PER_PROCESS_AND_THREAD_TIME_LIMIT=false
ENABLE_PER_PROCESS_AND_THREAD_MEMORY_LIMIT=false
ALLOW_ENABLE_PER_PROCESS_AND_THREAD_MEMORY_LIMIT=false
# Output file size limit in KB (stops programs from flooding output).
MAX_FILE_SIZE=1024
MAX_MAX_FILE_SIZE=1024
NUMBER_OF_RUNS=1
MAX_NUMBER_OF_RUNS=1
REDIRECT_STDERR_TO_STDOUT=false
MAX_EXTRACT_SIZE=10240

################################################################################
# Judge0's own Redis and PostgreSQL (separate from CodeArena's database).
################################################################################
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=judge0
POSTGRES_USER=judge0
POSTGRES_PASSWORD=CHANGE_ME
