# ------------------------------------------------------------------
# CodeArena backend configuration
# Copy this file to `.env` and fill in real values. Never commit .env.
# ------------------------------------------------------------------

ENVIRONMENT=development

# PostgreSQL connection (SQLAlchemy URL using the pure-Python pg8000 driver)
# Format: postgresql+pg8000://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+pg8000://codearena:change-me@localhost:5432/codearena

# JWT settings. Generate a secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Basic in-memory rate limiting for login/register (per client IP)
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_PER_MINUTE=10
REGISTER_RATE_LIMIT_PER_MINUTE=5

# Code execution (Judge0). Student code runs only inside Judge0's sandbox.
# Self-hosted: see infra/judge0 (JUDGE0_API_KEY = AUTHN_TOKEN from judge0.conf).
# Leave JUDGE0_BASE_URL empty to run without code execution.
JUDGE0_BASE_URL=
JUDGE0_API_KEY=
JUDGE0_API_KEY_HEADER=X-Auth-Token
JUDGE0_TIMEOUT=30
JUDGE0_POLL_INTERVAL=0.75
JUDGE0_MAX_CONCURRENT_JOBS=4
EXECUTION_MAX_SOURCE_BYTES=200000
RUN_RATE_LIMIT_PER_MINUTE=10
SUBMIT_RATE_LIMIT_PER_MINUTE=5

# Development seed accounts (used by app.utils.seed_admin / seed_staff)
# Use a normal-looking domain: reserved TLDs such as .local or .test are
# rejected by email validation and you would not be able to log in.
ADMIN_NAME=CodeArena Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

STAFF_NAME=Staff Member
STAFF_EMAIL=
STAFF_PASSWORD=
